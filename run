#!/usr/bin/env bash
set -euo pipefail

dry_run="0"

if [[ "${1:-}" == "--dry" ]]; then
    dry_run="1"
    shift
fi

task="${1:-}"

BASE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
TASKS_DIR="$BASE_DIR/tasks"

export SETUP_DIR="$BASE_DIR"
export dry_run
export ENV="${ENV:-$BASE_DIR}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

if [[ -z "$task" ]]; then
    echo "usage: ./run [--dry] <task>"
    exit 1
fi

task_path="$TASKS_DIR/$task"

if [[ ! -f "$task_path" ]]; then
    echo "task not found: $task"
    exit 1
fi

if [[ "$dry_run" == "1" ]]; then
    echo "[DRY_RUN] would run: bash $task_path"
    echo
    sed 's/^/[DRY_RUN] /' "$task_path"
    exit 0
fi

bash "$task_path"
