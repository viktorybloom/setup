#!/usr/bin/env bash

set -euo pipefail

cp -rfT .ssh/ $HOME/ | gpg --decrypt $HOME/.ssh/id_rsa.gpg

sudo -v

sudo pacman -Syyu --noconfirm

sudo pacman -S --needed --noconfirm \
	nvim stow tmux ghostty fzf tldr wget xclip curl git tree ripgrep neofetch zsh \
	base-devel cmake pkgconf docker docker-compose lua unzip libtool gettext htop \
	ccache go lsof ninja python-pip moreutils clang less zig  \
	platformio-core \
	sway greetd swaybg dmenu wofi waybar \
	brightnessctl pavucontol grim slurp xorg-wayland bluez-utils dosfstools sshpass \
	pulseaudio-alsa pulseaudio-bluetooth pulseaudio-equalizer pulseaudio-jackalsa-utils playerctl pacman-contrib \
	ttf-ubuntu-mono-nerd \
	ufw fail2ban 

git-config --global user.name "viktorybloom" 
git-config --global user.email "viktorsulejic@gmail.com"

sudo rm -rf /tmp/yay
sudo mkdir -p /tmp/yay
pushd /tmp/yay/
git clone https://aur.archlinux.org/yay-git.git
makepkg -si --noconfirm
popd

yay -S --needed --noconfirm \
	swaylock-effects autotiling 


sudo rm -rf $HOME/.dotfiles
git clone --recursive git@github.com:viktorybloom/dotfiles.git "$HOME/.dotfiles"
bash "$HOME/.dotfiles/arch"

sudo systemctl enable --now bluetooth docker.service containerd.service ufw fail2ban greetd

sudo groupadd docker
sudo usermod -aG docker $USER
newgrp docker

# Harden this .....
sudo ufw --force reset
sudo ufw default deny incoming
sudo ufw default allow outgoing
sudo ufw --force enable

sudo tee /etc/sysctl.d/99-laptop-network-hardening.conf >/dev/null <<EOF
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0
EOF

sudo sysctl --system



